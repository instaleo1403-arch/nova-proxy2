{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "6a15e5a5-37eb-4872-9126-7096d5fdda53","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "da4532ee8cfa40c58f3bb1c910ba7d48" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
